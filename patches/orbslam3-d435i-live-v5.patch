+namespace
+{
+constexpr float kMaximumGyroBiasRadS = 1.0f;
+constexpr float kMaximumAccelBiasMS2 = 10.0f;
+constexpr float kMaximumBiasRotationCorrectionRad = 1.0f;
+
+bool BiasIsSane(const Bias &bias)
+{
+    const Eigen::Vector3f gyro(bias.bwx, bias.bwy, bias.bwz);
+    const Eigen::Vector3f accel(bias.bax, bias.bay, bias.baz);
+    return gyro.allFinite() && accel.allFinite()
+        && gyro.norm() <= kMaximumGyroBiasRadS
+        && accel.norm() <= kMaximumAccelBiasMS2;
+}
+
+bool BiasDeltaIsSane(const Eigen::Vector3f &gyro,
+                     const Eigen::Vector3f &accel)
+{
+    return gyro.allFinite() && accel.allFinite()
+        && gyro.norm() <= kMaximumGyroBiasRadS
+        && accel.norm() <= kMaximumAccelBiasMS2;
+}
+
+void ReportRejectedBiasCorrection(const char *site,
+                                  const Eigen::Vector3f &gyro,
+                                  const Eigen::Vector3f &accel)
+{
+    static std::atomic<unsigned int> warning_count{0};
+    const unsigned int index = warning_count.fetch_add(1);
+    if(index < 20)
+    {
+        std::cerr << "[IMU_NUMERIC_GUARD] site=" << site
+                  << " gyro_delta=" << gyro.transpose()
+                  << " accel_delta=" << accel.transpose() << std::endl;
+    }
+}
+
+Eigen::Matrix3f CorrectedRotationOrOriginal(
+    const Eigen::Matrix3f &original,
+    const Eigen::Matrix3f &jacobian,
+    const Eigen::Vector3f &gyro_delta,
+    const char *site)
+{
+    const Eigen::Vector3f correction = jacobian * gyro_delta;
+    if(!original.allFinite() || !jacobian.allFinite()
+       || !gyro_delta.allFinite() || !correction.allFinite()
+       || correction.norm() > kMaximumBiasRotationCorrectionRad)
+    {
+        ReportRejectedBiasCorrection(
+            site, gyro_delta, Eigen::Vector3f::Zero());
+        return original.allFinite() ? original : Eigen::Matrix3f::Identity();
+    }
+    const Eigen::Matrix3f corrected =
+        original * Sophus::SO3f::exp(correction).matrix();
+    return corrected.allFinite() ? NormalizeRotation(corrected) : original;
+}
+}
